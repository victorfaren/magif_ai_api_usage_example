# Magify API Configuration
# Copy this file to .env.local and fill in your values

# The URL where the Magify API is running
NEXT_PUBLIC_MAGIFY_API_URL=http://localhost:3001

# Your Magify API key (from Dashboard → API Keys)
NEXT_PUBLIC_MAGIFY_API_KEY=

# Your Agent ID (from Dashboard → Agent Settings)
NEXT_PUBLIC_MAGIFY_AGENT_ID=
